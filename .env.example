# ── Core ─────────────────────────────────────────────
DATABASE_URL="postgresql://marqova:marqova@localhost:5432/marqova"
# Public base URL (used for metadata, sitemap, emails, Stripe redirects)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── Auth.js ──────────────────────────────────────────
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET="replace-me-with-a-long-random-string"
AUTH_TRUST_HOST=true
# Optional Google sign-in (button is hidden when these are empty)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ── Search (Meilisearch) ─────────────────────────────
# When MEILI_HOST is empty, search falls back to PostgreSQL.
MEILI_HOST="http://localhost:7700"
MEILI_MASTER_KEY="marqova-dev-master-key"

# ── Storage ──────────────────────────────────────────
# "local" writes to ./public/uploads; "s3" uses any S3-compatible service (AWS, R2, MinIO…)
STORAGE_DRIVER="local"
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_URL=""

# ── Payments ─────────────────────────────────────────
# Comma separated list of enabled providers: mock, cod, stripe
PAYMENT_PROVIDERS="mock,cod"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ── AI (listing generation, review summaries, NL search, assistant) ──
# "mock" (default) or "anthropic"
AI_PROVIDER="mock"
ANTHROPIC_API_KEY=""
AI_MODEL="claude-sonnet-5-5"

# ── Virtual try-on ───────────────────────────────────
# "mock" (default) or "http" (POSTs to TRYON_API_URL)
TRYON_PROVIDER="mock"
TRYON_API_URL=""
TRYON_API_KEY=""

# ── Email ────────────────────────────────────────────
# Empty SMTP_HOST = emails are logged to the console (development)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="Marqova <no-reply@marqova.example>"

# ── Background jobs ──────────────────────────────────
# Set to true only when a trusted proxy/platform (Vercel, nginx, Cloudflare) overwrites
# X-Real-IP / X-Forwarded-For. Otherwise per-IP rate limits are disabled (per-account login
# limits still apply) and a warning is logged in production.
TRUST_PROXY="false"

# Shared secret for POST /api/jobs/run (call from a cron every minute)
JOBS_SECRET="replace-me"
